rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function hasActiveSubscription() {
      return signedIn() && (
        request.auth.token.email == "solanojhonatan2000@gmail.com" ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.subscriptionStatus == "active"
      );
    }

    function hasClassAccess(classId) {
      return signedIn() && (
        request.auth.token.email == "solanojhonatan2000@gmail.com" ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("classAccessBlocked", false) != true ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("blockedClassId", "") != classId
      );
    }

    function validAttachment() {
      return request.resource == null ||
        (request.resource.size < 8 * 1024 * 1024 &&
          request.resource.contentType in [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
            "application/pdf",
            "application/msword",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            "application/octet-stream"
          ]);
    }

    function validQuestionImage() {
      return request.resource == null ||
        (request.resource.size < 6 * 1024 * 1024 &&
          request.resource.contentType in [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif"
          ]);
    }

    function validProfilePhoto() {
      return request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType in [
          "image/jpeg",
          "image/png",
          "image/webp"
        ];
    }

    function teacherQuestion(questionId) {
      return firestore.get(/databases/(default)/documents/teacherQuestions/$(questionId)).data;
    }

    function canReadTeacherQuestion(questionId) {
      return hasActiveSubscription() && (
        teacherQuestion(questionId).ownerUid == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.classOwnerUid ==
          teacherQuestion(questionId).ownerUid
      );
    }

    function message(messageId) {
      return firestore.get(/databases/(default)/documents/classMessages/$(messageId)).data;
    }

    function reply(replyId) {
      return firestore.get(/databases/(default)/documents/messageReplies/$(replyId)).data;
    }

    function canReadMessage(messageId) {
      return hasActiveSubscription() && (
        message(messageId).ownerUid == request.auth.uid ||
        (
          request.auth.token.email in message(messageId).toEmails &&
          hasClassAccess(message(messageId).classId)
        )
      );
    }

    function canReadReply(replyId) {
      return hasActiveSubscription() && (
        reply(replyId).ownerUid == request.auth.uid ||
        reply(replyId).fromUid == request.auth.uid ||
        (
          request.auth.token.email in message(reply(replyId).messageId).toEmails &&
          hasClassAccess(reply(replyId).classId)
        )
      );
    }

    match /classMessages/{messageId}/{fileName} {
      allow read: if canReadMessage(messageId);
      allow write: if hasActiveSubscription() &&
        message(messageId).ownerUid == request.auth.uid &&
        validAttachment();
    }

    match /messageReplies/{replyId}/{fileName} {
      allow read: if canReadReply(replyId);
      allow write: if hasActiveSubscription() &&
        reply(replyId).fromUid == request.auth.uid &&
        validAttachment();
    }

    match /teacherQuestions/{ownerUid}/{questionId}/{fileName} {
      allow read: if canReadTeacherQuestion(questionId);
      allow write: if hasActiveSubscription() &&
        request.auth.uid == ownerUid &&
        teacherQuestion(questionId).ownerUid == request.auth.uid &&
        validQuestionImage();
    }

    match /profilePhotos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        validProfilePhoto();
      allow delete: if signedIn() &&
        request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
