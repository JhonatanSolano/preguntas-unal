rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == "solanojhonatan2000@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
      );
    }

    function ownsClass(classId) {
      return isAdmin() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }

    function joinsExistingClass(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid;
    }

    function learnsFrom(ownerUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classOwnerUid == ownerUid;
    }

    match /users/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /studentState/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /groupPermissions/{groupId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classPermissions/{classId} {
      allow read: if signedIn();
      allow write: if ownsClass(classId);
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if isAdmin() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    match /countries/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teacherQuestions/{questionId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        learnsFrom(resource.data.ownerUid)
      );
      allow create: if isAdmin() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.options.size() == 4 &&
        request.resource.data.correctOption >= 0 &&
        request.resource.data.correctOption <= 3 &&
        request.resource.data.level in ["diagnostico", "nivel1", "examen"];
      allow update: if isAdmin() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    match /classStudents/{studentId} {
      allow read: if signedIn();
      allow create, update: if (isAdmin() && ownsClass(request.resource.data.classId)) ||
        joinsExistingClass(request.resource.data.classId);
      allow delete: if (isAdmin() && ownsClass(resource.data.classId)) ||
        (signedIn() && resource.data.userUid == request.auth.uid);
    }

    match /classInvites/{inviteId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.email == request.auth.token.email ||
        resource.data.studentEmail == request.auth.token.email
      );
      allow create, update: if (isAdmin() && ownsClass(request.resource.data.classId)) ||
        (signedIn() &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.status in ["pending", "accepted"]);
      allow delete: if isAdmin() && ownsClass(resource.data.classId);
    }

    match /classMessages/{messageId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        request.auth.token.email in resource.data.toEmails
      );
      allow create: if isAdmin() && ownsClass(request.resource.data.classId);
      allow update, delete: if isAdmin() && resource.data.ownerUid == request.auth.uid;
    }

    match /messageReplies/{replyId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/classMessages/$(resource.data.messageId)) &&
          request.auth.token.email in get(/databases/$(database)/documents/classMessages/$(resource.data.messageId)).data.toEmails
        )
      );
      allow create: if signedIn() &&
        exists(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)).data.ownerUid &&
        request.resource.data.classId == get(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)).data.classId &&
        (
          request.resource.data.ownerUid == request.auth.uid ||
          request.auth.token.email in get(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)).data.toEmails
        );
      allow update, delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isAdmin() ||
        resource.data.targetUid == request.auth.uid ||
        resource.data.targetEmail == request.auth.token.email
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.targetEmail == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    match /recoveryContacts/{phoneId} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
