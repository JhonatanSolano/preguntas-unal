rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == "solanojhonatan2000@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "teacher"
      );
    }

    function isPlatformOwner() {
      return signedIn() &&
        request.auth.token.email == "solanojhonatan2000@gmail.com";
    }

    function hasActiveSubscription() {
      return isPlatformOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == "active" ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionInherited == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionSubscriptionStatus == "active" &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionAccessRevoked != true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionMemberStatus != "removed" &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionMemberStatus != "blocked"
          )
        )
      );
    }

    function protectsSubscriptionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "subscriptionStatus",
        "subscriptionExpiresAt",
        "subscriptionPlan",
        "subscriptionStartedAt",
        "subscriptionNextBillingAt",
        "subscriptionAmountCOP",
        "subscriptionAutoRenew",
        "subscriptionPaymentPaused",
        "paymentProvider",
        "paymentMethods",
        "paymentCustomerId",
        "paymentSourceId",
        "lastPaymentId",
        "classAccessBlocked",
        "blockedClassId"
      ]);
    }

    function hasClassAccess(classId) {
      return isPlatformOwner() || (
        signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("classAccessBlocked", false) != true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("blockedClassId", "") != classId
        )
      );
    }

    function ownsClass(classId) {
      return isAdmin() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }

    function ownsInstitutionOfClass(classId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        ownsInstitution(get(/databases/$(database)/documents/classes/$(classId)).data.institutionDane);
    }

    function ownsInstitution(institutionId) {
      return signedIn() &&
        institutionId is string &&
        exists(/databases/$(database)/documents/institutions/$(institutionId)) &&
        get(/databases/$(database)/documents/institutions/$(institutionId)).data.ownerUid == request.auth.uid;
    }

    function joinsExistingClass(classId) {
      return hasActiveSubscription() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid;
    }

    function learnsFrom(ownerUid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classOwnerUid == ownerUid &&
        hasClassAccess(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId);
    }

    match /users/{uid} {
      allow read: if isPlatformOwner() ||
        (signedIn() && request.auth.uid == uid) ||
        ownsInstitution(resource.data.institutionDane) ||
        (isAdmin() && resource.data.classOwnerUid == request.auth.uid);
      allow create: if isPlatformOwner() || (
        signedIn() &&
        request.auth.uid == uid &&
        !request.resource.data.keys().hasAny([
          "subscriptionStatus",
          "subscriptionExpiresAt",
          "subscriptionPlan",
          "subscriptionStartedAt",
          "subscriptionNextBillingAt",
          "subscriptionAmountCOP",
          "subscriptionAutoRenew",
          "subscriptionPaymentPaused",
          "paymentProvider",
          "paymentMethods",
          "paymentCustomerId",
          "paymentSourceId",
          "lastPaymentId"
        ])
      );
      allow update: if isPlatformOwner() || (
        (
          (signedIn() && request.auth.uid == uid) ||
          ownsInstitution(resource.data.institutionDane) ||
          (isAdmin() && resource.data.classOwnerUid == request.auth.uid)
        ) &&
        protectsSubscriptionFields()
      );
      allow delete: if isPlatformOwner() ||
        (signedIn() && request.auth.uid == uid) ||
        ownsInstitution(resource.data.institutionDane) ||
        (isAdmin() && resource.data.classOwnerUid == request.auth.uid);
    }

    match /studentState/{uid} {
      allow read, write: if hasActiveSubscription() &&
        (isAdmin() || (signedIn() && request.auth.uid == uid));
    }

    match /groupPermissions/{groupId} {
      allow read: if signedIn();
      allow write: if hasActiveSubscription() && isAdmin();
    }

    match /classPermissions/{classId} {
      allow read: if signedIn();
      allow write: if hasActiveSubscription() && ownsClass(classId);
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if hasActiveSubscription() && isAdmin() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if hasActiveSubscription() && isAdmin() &&
        resource.data.ownerUid == request.auth.uid;
    }

    match /countries/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /institutions/{institutionId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.institutionDane == institutionId;
      allow update, delete: if isPlatformOwner() ||
        (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /institutionAdmins/{adminId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.uid == request.auth.uid) ||
        ownsInstitution(resource.data.institutionDane);
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        ownsInstitution(request.resource.data.institutionDane);
      allow update, delete: if isPlatformOwner() ||
        ownsInstitution(resource.data.institutionDane);
    }

    match /institutionMembers/{memberId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.email == request.auth.token.email) ||
        ownsInstitution(resource.data.institutionDane);
      allow create: if isPlatformOwner() ||
        ownsInstitution(request.resource.data.institutionDane);
      allow update, delete: if isPlatformOwner() ||
        ownsInstitution(resource.data.institutionDane) ||
        (
          signedIn() &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.institutionDane == resource.data.institutionDane &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == "active"
        );
    }

    match /institutionRequests/{requestId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.requesterUid == request.auth.uid) ||
        ownsInstitution(resource.data.institutionDane);
      allow create: if hasActiveSubscription() &&
        signedIn() &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.status == "pending" &&
        request.resource.data.action in ["add-students", "remove-student"];
      allow update: if isPlatformOwner() ||
        ownsInstitution(resource.data.institutionDane) ||
        (
          signedIn() &&
          resource.data.requesterUid == request.auth.uid &&
          request.resource.data.status == resource.data.status
        );
      allow delete: if isPlatformOwner() ||
        ownsInstitution(resource.data.institutionDane);
    }

    match /teacherQuestions/{questionId} {
      allow read: if hasActiveSubscription() && (
        resource.data.ownerUid == request.auth.uid ||
        learnsFrom(resource.data.ownerUid)
      );
      allow create: if hasActiveSubscription() && isAdmin() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.options.size() == 4 &&
        request.resource.data.correctOption >= 0 &&
        request.resource.data.correctOption <= 3 &&
        request.resource.data.level in ["diagnostico", "nivel1", "examen"];
      allow update: if hasActiveSubscription() && isAdmin() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if hasActiveSubscription() && isAdmin() &&
        resource.data.ownerUid == request.auth.uid;
    }

    match /classStudents/{studentId} {
      allow read: if hasActiveSubscription();
      allow create: if hasActiveSubscription() && (
        (isAdmin() && ownsClass(request.resource.data.classId)) ||
        ownsInstitutionOfClass(request.resource.data.classId) ||
        (
          joinsExistingClass(request.resource.data.classId) &&
          request.resource.data.status == "activo"
        )
      );
      allow update: if hasActiveSubscription() && (
        (isAdmin() && ownsClass(request.resource.data.classId)) ||
        ownsInstitutionOfClass(request.resource.data.classId) ||
        (
          resource.data.status != "bloqueado" &&
          request.resource.data.status == resource.data.status &&
          joinsExistingClass(request.resource.data.classId)
        )
      );
      allow delete: if hasActiveSubscription() && (
        (isAdmin() && ownsClass(resource.data.classId)) ||
        ownsInstitutionOfClass(resource.data.classId) ||
        (signedIn() && resource.data.userUid == request.auth.uid)
      );
    }

    match /classInvites/{inviteId} {
      allow read: if hasActiveSubscription() && (
        isAdmin() ||
        resource.data.email == request.auth.token.email ||
        resource.data.studentEmail == request.auth.token.email
      );
      allow create, update: if hasActiveSubscription() && (
        (isAdmin() && ownsClass(request.resource.data.classId)) ||
        ownsInstitutionOfClass(request.resource.data.classId) ||
        (signedIn() &&
          resource.data.email == request.auth.token.email &&
          request.resource.data.email == request.auth.token.email &&
          request.resource.data.status in ["pending", "accepted"])
      );
      allow delete: if hasActiveSubscription() && (
        (isAdmin() && ownsClass(resource.data.classId)) ||
        ownsInstitutionOfClass(resource.data.classId)
      );
    }

    match /classMessages/{messageId} {
      allow read: if hasActiveSubscription() && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.auth.token.email in resource.data.toEmails &&
          hasClassAccess(resource.data.classId)
        )
      );
      allow create: if hasActiveSubscription() && isAdmin() &&
        ownsClass(request.resource.data.classId);
      allow update, delete: if hasActiveSubscription() && isAdmin() &&
        resource.data.ownerUid == request.auth.uid;
    }

    match /messageReplies/{replyId} {
      allow read: if hasActiveSubscription() && (
        isAdmin() ||
        resource.data.ownerUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/classMessages/$(resource.data.messageId)) &&
          request.auth.token.email in get(/databases/$(database)/documents/classMessages/$(resource.data.messageId)).data.toEmails &&
          hasClassAccess(resource.data.classId)
        )
      );
      allow create: if hasActiveSubscription() &&
        exists(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.ownerUid == get(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)).data.ownerUid &&
        request.resource.data.classId == get(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)).data.classId &&
        (
          request.resource.data.ownerUid == request.auth.uid ||
          (
            request.auth.token.email in get(/databases/$(database)/documents/classMessages/$(request.resource.data.messageId)).data.toEmails &&
            hasClassAccess(request.resource.data.classId)
          )
        );
      allow update, delete: if hasActiveSubscription() &&
        resource.data.fromUid == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if hasActiveSubscription() && (
        isAdmin() ||
        resource.data.targetUid == request.auth.uid ||
        resource.data.targetEmail == request.auth.token.email
      );
      allow create: if hasActiveSubscription();
      allow update: if hasActiveSubscription() && (
        resource.data.targetUid == request.auth.uid ||
        resource.data.targetEmail == request.auth.token.email
      );
      allow delete: if isAdmin();
    }

    match /billingRequests/{requestId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == "pending" &&
        request.resource.data.type in [
          "pause-renewal",
          "resume-renewal",
          "remove-payment-method",
          "set-default-payment-method",
          "upgrade-plan",
          "payment-intent"
        ];
      allow update, delete: if isPlatformOwner();
    }

    match /billingTransactions/{transactionId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isPlatformOwner();
    }

    match /paymentIntents/{intentId} {
      allow read: if isPlatformOwner() ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isPlatformOwner();
    }

    match /billingEvents/{eventId} {
      allow read, write: if isPlatformOwner();
    }

    match /recoveryContacts/{phoneId} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }
  }
}
